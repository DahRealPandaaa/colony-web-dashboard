# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Forge / NeoForge dev run directories. Each versions/<mc>-<loader> project has its own set,
# so these stay unanchored to match at any depth.
run/
run-client/
run-server/
run-gametest/
run-data/
runs/

# Compiled output
bin/
*.class

# Logs
logs/
*.log

# Dashboard runtime data (auth.json, downloaded vanilla client jar, generated textures).
# Leading slash matters — an unanchored "colonyweb/" would also match the source package.
/colonyweb/
/colonyweb-cache/

# Claude
.claude/

# IDE files
.idea/
*.iml
*.ipr
*.iws
.settings/
.classpath
.project
.vscode/*
!.vscode/tasks.json

# OS files
.DS_Store
Thumbs.db

# Frontend tooling. Only dependencies are ignored — everything the server actually serves out of
# webroot/ (style.css, js/) is committed, because the jar ships those files as-is.
common/src/main/resources/webroot/node_modules/

.playwright-mcp/
.kotlin/