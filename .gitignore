# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Forge / NeoForge dev run directories. Each versions/<mc>-<loader> project has its own set,
# so these stay unanchored to match at any depth.
run/
run-client/
run-server/
run-gametest/
run-data/
runs/

# Compiled output
bin/
*.class

# Logs
logs/
*.log

# Dashboard runtime data (auth.json, downloaded vanilla client jar, generated textures).
# Leading slash matters — an unanchored "colonyweb/" would also match the source package.
/colonyweb/
/colonyweb-cache/

# Claude
.claude/

# IDE files
.idea/
*.iml
*.ipr
*.iws
.settings/
.classpath
.project
.vscode/*
!.vscode/tasks.json

# OS files
.DS_Store
Thumbs.db

# Frontend build output (generated by Vite)
common/src/main/resources/webroot/node_modules/
common/src/main/resources/webroot/js/app.js
common/src/main/resources/webroot/style.css

.playwright-mcp/
.kotlin/