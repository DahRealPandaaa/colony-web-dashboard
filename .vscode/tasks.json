{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Minecraft: Run Client (Singleplayer)",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew",
            "windows": {
                "command": "${workspaceFolder}\\gradlew.bat"
            },
            "args": [
                "runClient",
                "--console=plain"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "minecraft-dev",
                "clear": true
            }
        },
        {
            "label": "Minecraft: Run Dedicated Server",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew",
            "windows": {
                "command": "${workspaceFolder}\\gradlew.bat"
            },
            "args": [
                "runServer",
                "--console=plain"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "minecraft-dev",
                "clear": true
            }
        },
        {
            "label": "Minecraft: Run Client + Server",
            "dependsOn": [
                "Minecraft: Run Client (Singleplayer)",
                "Minecraft: Run Dedicated Server"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ]
}